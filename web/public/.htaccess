# Hostinger (Apache/LiteSpeed): serve index.html for every app route.
Options -MultiViews
RewriteEngine On
# The API and admin code may sit in folders under this one on shared hosting: never serve them here.
RewriteRule ^(api|admin|web|src|public|node_modules|vendor|storage)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|vite\.config\.ts|tsconfig.*\.json|eslint\.config\.js)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
