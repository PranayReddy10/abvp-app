# Hostinger (Apache/LiteSpeed): serve index.html for every app route.
Options -MultiViews
RewriteEngine On
# This branch is cloned straight into public_html: the API, admin, source and docs folders sit under this one. Never serve them (or dot-files like .git) from the main domain.
RewriteRule ^(api|admin|source|docs|web|src|public|node_modules|vendor|storage)(/|$) - [F,L]
RewriteRule ^(README\.md|build\.sh|composer\.(json|lock)|package(-lock)?\.json|artisan|vite\.config\.ts|tsconfig.*\.json|eslint\.config\.js)$ - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
